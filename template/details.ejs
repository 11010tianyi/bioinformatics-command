<%- include('partial/header'); %>
<%- include('widget/search',{type: "list"}); %>
<script type="text/javascript" src="<%=relative_path%>js/copy-to-clipboard.js"></script>

<div class="markdown-body">
<% if(md_path){ %>
<span class="edit_btn">
<a target="_blank" href="https://github.com/11010tianyi/bioinformatics-command/edit/master<%=md_path%>">纠正错误 / Fix</a>
<span class="split"></span>
<a target="_blank" href="https://github.com/11010tianyi/bioinformatics-command/edit/master<%=md_path%>">添加实例 / Add example</a>
</span>
<% } %>

<% if(describe.formatLinks && describe.formatLinks.length){ %>
<div class="format-usedby">
  <strong>文件格式 / Formats</strong>
  <div class="format-chip-list">
    <% describe.formatLinks.forEach(function(format){ %>
      <% if(format.path){ %>
      <a class="format-chip" href="../<%=format.path.replace(/^\//,'')%>"><%=format.name%></a>
      <% } else { %>
      <span class="format-chip"><%=format.name%></span>
      <% } %>
    <% }); %>
  </div>
</div>
<% } %>

<%-mdhtml%>

</div>
<%- include('widget/footer',{type: "list"}); %>
<%- include('partial/footer'); %>
