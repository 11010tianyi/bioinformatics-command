<github-corners target="__blank" z-index="999" position="fixed" href="https://github.com/11010tianyi/bioinformatics-command"></github-corners>
<div class="header<%if(type=='list'){%> header_list<%}%><%if(type=='home'){%> home<%}%>">
  <div class="header_inner">
      <div class="logo">
          <a href="<%=relative_path%>index.html" title="Bioinformatics Commands">
            <span class="brand-main">Bio Commands</span>
            <span class="brand-sub">生信命令大全</span>
          </a>
      </div>
      <div class="search">
          <ul class="search-list" id="result"></ul>
          <input type="text" class="query" id="query" autocomplete="off" autofocus="autofocus" placeholder="samtools / VCF / RNA-seq / 比对"/>
          <div class="enter-input">
              <input type="hidden" id="current_path" value="<%=current_path%>">
              <button id="search_btn">Search</button>
          </div>
      </div>
  </div>
</div>
